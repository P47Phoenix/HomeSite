{
  "name": "homesite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-JS prerendered static landing page for home-lab services (React as build-time templating).",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "bundleBudgetGzipKB": "250"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:unit": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:docs-coverage": "node scripts/check-docs-coverage.mjs",
    "check:docs-presence": "node scripts/check-docs-presence.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:workflows": "bash scripts/check-workflow-security.sh"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "axe-core": "4.12.1",
    "eslint": "10.8.0",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
